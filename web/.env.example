# Web app environment — copy this to web/.env.local and fill in.
#
#   cp web/.env.example web/.env.local
#
# web/.env.local is gitignored (see root .gitignore: **/.env*.local). Never
# commit real values. On the VPS, place the same file at web/.env.local and
# restart the PM2 process so `next start` picks it up.

# ── Database (required) ──────────────────────────────────────────────────────
# Neon Postgres connection string. Used by every API route via web/src/lib/db.ts.
# Get it from https://console.neon.tech → your project → Connection details.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ── Gmail draft creation (required for the "Create Gmail draft" button) ──────
# App password (16 chars, NOT your login password):
# https://myaccount.google.com/apppasswords  (requires 2FA)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ── Identity (optional) ──────────────────────────────────────────────────────
# If set, this fixed user id is used instead of the x-user-id header/fallback.
# NEXT_PUBLIC_USER_ID=user_xxx
# VIP_USER_ID=user_xxx

# ── Career-ops checkout (optional) ───────────────────────────────────────────
# Points the web app at a full career-ops checkout (modes/, scripts/, reports/).
# Defaults to the repo root when run from the checkout.
# CAREER_OPS_ROOT=/path/to/career-ops
